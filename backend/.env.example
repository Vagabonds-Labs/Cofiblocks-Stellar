# Supabase settings
DATABASE_URL="postgresql://postgres..."
DIRECT_URL="postgresql://postgres..."

PORT=4000
FRONTEND_URL="http://localhost:3000"

RESEND_API_KEY=
RESEND_FROM_EMAIL=info@news.cofiblocks.com

CAVOS_APP_ID=
CAVOS_ALLOWED_CONTRACTS=[]
CAVOS_MAX_CALLS_PER_TX=0
# Example:
# CAVOS_SPENDING_LIMITS=[{"token":"0x053c...","limit":"1000000000000000000"}]
CAVOS_SPENDING_LIMITS=[]

STARKNET_NETWORK=mainnet

RPC_URL=
MAINNET_ACCOUNT_ADDR=
MAINNET_ACCOUNT_PRIVATE_KEY=

# development for more log verbosity and also for cookie setting
NODE_ENV=development

# Session secrets
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=10m
JWT_REFRESH_EXPIRY=7d
