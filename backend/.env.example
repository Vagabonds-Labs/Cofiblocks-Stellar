# Supabase settings
DATABASE_URL="postgresql://postgres..."
DIRECT_URL="postgresql://postgres..."

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Origen público del backend. Junto con FRONTEND_URL decide si las cookies de
# sesión se emiten como cross-domain (SameSite=None; Secure). Si el frontend
# está en otro dominio — Vercel, por ejemplo — y esto queda mal, el login falla
# en silencio: el navegador descarta la cookie y el usuario nunca queda logueado.
BACKEND_URL="http://localhost:4000"
# Fuerza el modo cross-domain sin depender de la comparación de arriba.
ALLOW_CROSS_DOMAIN_COOKIES=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=info@news.cofiblocks.com
# Copias de los avisos de pedido que se mandan al productor, separadas por coma.
ADMIN_EMAILS=

# ── Supabase Storage (imágenes de productos y fincas) ─────────────────────
# Sin esto, la subida de imágenes falla al publicar un producto.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# ── Stellar ───────────────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet

# Cuenta del backend. Es el admin de los contratos, paga los fees vía fee-bump
# y patrocina las reservas de las trustlines de USDC, así el usuario nunca
# necesita XLM. Clave secreta S… del par que despliega los contratos.
STELLAR_ADMIN_SECRET=

# Opcionales: si se dejan vacíos se usan los públicos de cada red.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# Sólo en mainnet: direcciones que emite contracts/scripts/deploy.sh.
STELLAR_MARKETPLACE_ADDRESS=
STELLAR_DISTRIBUTION_ADDRESS=

# development for more log verbosity and also for cookie setting
NODE_ENV=development

# Session secrets
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=10m
JWT_REFRESH_EXPIRY=7d
