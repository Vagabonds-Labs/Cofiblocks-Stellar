# Identidad del CLI de Stellar que despliega y administra los contratos.
# Se crea con `stellar keys generate` (ver ../scripts/setup-testnet.sh).
STELLAR_ADMIN_IDENTITY=cofi-admin

# Fee de mercado en basis points. 5000 = 50 %.
MARKET_FEE_BPS=5000

# RPC. Dejar vacío para usar los públicos.
STELLAR_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
STELLAR_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com

# Emisor de USDC. En mainnet es el de Circle; en testnet, el activo de prueba
# que emite `cofi-usdc-issuer`. Dejar vacío para usar el default de cada red.
USDC_ISSUER=
